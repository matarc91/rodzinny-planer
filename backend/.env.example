# =============================================
# Planer Rodzinny – Backend Environment
# Skopiuj ten plik jako .env i uzupełnij wartości
# =============================================

# -- Baza danych --
DB_PASSWORD=ZMIEN_NA_SILNE_HASLO_DB

# -- JWT (tokeny logowania) --
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ZMIEN_NA_LOSOWY_SEKRET_64_ZNAKI
JWT_EXPIRES_IN=7d

# -- Web Push VAPID --
# Wygeneruj poniżej (patrz README):
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=WKLEJ_TUTAJ_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=WKLEJ_TUTAJ_VAPID_PRIVATE_KEY
# Twój email kontaktowy (wymagany przez standard Web Push)
VAPID_SUBJECT=mailto:arciszewskimateusz@gmail.com

# -- Email (SMTP) --
# Możesz użyć Brevo (dawne Sendinblue) - darmowe 300 maili/dzień
# lub Gmail App Password / własny serwer pocztowy
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=twoj_login@brevo.com
SMTP_PASS=TWOJE_HASLO_SMTP
SMTP_FROM="Rodzinny Planer <noreply@cosmere.syncup.pl>"

# -- Aplikacja --
# URL frontendu (Vercel lub własny)
APP_URL=https://rodzinny-planer-six.vercel.app
# URL API backendu (dostępny z internetu przez Tailscale lub serwer publiczny)
API_URL=https://planer.cosmere.syncup.pl
